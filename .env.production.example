# ============================================
# GYDI Frontend - PRODUCTION Environment
# ============================================
# This file shows how to configure production environment
# NEVER commit actual production secrets to git!

# ============================================
# NextAuth Configuration (PRODUCTION)
# ============================================
# CRITICAL: Generate a STRONG secret for production
# Must be at least 32 characters, random, and unique per environment
#
# Generate with: openssl rand -base64 32
#
NEXTAUTH_URL=https://gydi.com
NEXTAUTH_SECRET=${NEXTAUTH_SECRET_FROM_SECRETS_MANAGER}

# ============================================
# Backend API (PRODUCTION)
# ============================================
NEXT_PUBLIC_API_URL=https://api.gydi.com

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_APP_URL=https://gydi.com

# ============================================
# Analytics (PRODUCTION)
# ============================================
NEXT_PUBLIC_GA_ID=${GA_ID}
NEXT_PUBLIC_POSTHOG_KEY=${POSTHOG_KEY}

# ============================================
# Feature Flags (PRODUCTION)
# ============================================
NEXT_PUBLIC_ENABLE_REFERRALS=true
NEXT_PUBLIC_ENABLE_SUBSCRIPTIONS=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ============================================
# Payment Processing (PRODUCTION)
# ============================================
# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLIC_KEY}
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}

# ============================================
# Third-party Services
# ============================================
# Mapbox for property maps
NEXT_PUBLIC_MAPBOX_TOKEN=${MAPBOX_TOKEN}

# Image optimization
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}

# Email (if using from frontend)
# RESEND_API_KEY=${RESEND_API_KEY}

# ============================================
# Security Headers (Vercel deployment)
# ============================================
# These are configured in next.config.ts
# But can be overridden via environment variables if needed
