# ============================================
# GYDI Frontend - PRODUCTION Environment
# ============================================
# This file is a TEMPLATE for production environment variables
# In Vercel, set these in: Settings → Environment Variables → Production
# Copy values to Vercel Dashboard, DO NOT commit actual secrets
#
# CRITICAL SECURITY:
# - ALL secrets must be unique (never reuse from dev/staging)
# - ALL secrets must be strong (minimum lengths enforced)
# - Secrets must be rotated every 90-180 days
# - NEVER commit production secrets to git
#
# See ../ENVIRONMENT_STRATEGY.md for detailed documentation
# ============================================

# ============================================
# NextAuth Configuration (PRODUCTION)
# ============================================
# CRITICAL: Generate a STRONG secret for production
# Must be at least 32 characters, random, and unique
#
# Generate: openssl rand -base64 32
#
NEXTAUTH_URL=https://app.gydi.com
NEXTAUTH_SECRET=your_production_nextauth_secret_must_be_strong_and_unique_32_chars_min

# ============================================
# Backend API (PRODUCTION)
# ============================================
# Public variable (exposed to browser)
NEXT_PUBLIC_API_URL=https://api.gydi.com
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Supabase Configuration (PRODUCTION - if used directly)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key

# ============================================
# Cloud Services (PRODUCTION)
# ============================================
# Cloudinary (production folder with backups)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_production_api_key
CLOUDINARY_API_SECRET=your_production_api_secret

# ============================================
# Stripe Payment (LIVE KEYS - Real money!)
# ============================================
# CRITICAL: Use LIVE keys (sk_live_..., pk_live_...)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key

# ============================================
# Application Configuration (PRODUCTION)
# ============================================
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_APP_URL=https://app.gydi.com
NEXT_PUBLIC_ENV=production

# ============================================
# Feature Flags (PRODUCTION - Controlled rollouts)
# ============================================
# Enable features gradually in production
NEXT_PUBLIC_FEATURE_ML_RECOMMENDATIONS=false
NEXT_PUBLIC_FEATURE_NEW_UI=false
NEXT_PUBLIC_FEATURE_AB_TESTING=false
NEXT_PUBLIC_FEATURE_REFERRALS=true
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=true

# ============================================
# Analytics & Monitoring (PRODUCTION)
# ============================================
# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Hotjar (heatmaps and session recording)
NEXT_PUBLIC_HOTJAR_ID=1234567

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ============================================
# Build & Runtime
# ============================================
NODE_ENV=production

# ============================================
# Optional - Third-party Services (PRODUCTION)
# ============================================
# Mapbox (for property maps)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ciIsImEiOiJjbXh4eHh4eHgifQ.xxxxxxxxxx

# ============================================
# Security Notes
# ============================================
# Security headers are configured in next.config.ts
# CSP, HSTS, X-Frame-Options, etc.
#
# Rate limiting is handled by Vercel Edge Middleware
# See: middleware.ts
