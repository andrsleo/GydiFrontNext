# ============================================
# GYDI Frontend - Development Environment
# ============================================
# This file contains environment variables for DEVELOPMENT only.
# Tokens are stored in localStorage and sent via Authorization header.

# ============================================
# Environment
# ============================================
NODE_ENV=development

# ============================================
# Backend API Configuration
# ============================================
# Public variables (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ============================================
# Application Configuration
# ============================================
# Public variables (exposed to browser)
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Debug
# ============================================
NEXT_PUBLIC_LOG_LEVEL=debug

# ============================================
# Authentication Mode (Development)
# ============================================
# Development: Backend returns tokens in response body
# Frontend stores in localStorage and sends via Authorization header
# No httpOnly cookies in development
