# ============================================
# GYDI Frontend - Development Environment (Railway Dev + Vercel Preview)
# ============================================
# This file is a TEMPLATE for development/staging environment variables
# In Vercel, set these in: Settings → Environment Variables → Preview
# Copy values to Vercel Dashboard, DO NOT commit actual secrets
#
# See ../ENVIRONMENT_STRATEGY.md for detailed documentation
# ============================================

# ============================================
# NextAuth Configuration
# ============================================
# Set in Vercel Environment Variables (Preview environment)
# Generate: openssl rand -base64 32
NEXTAUTH_URL=https://gydi-dev.vercel.app
NEXTAUTH_SECRET=your_dev_nextauth_secret_at_least_32_chars

# ============================================
# Backend API Configuration
# ============================================
# Public variable (exposed to browser)
NEXT_PUBLIC_API_URL=https://gydi-backend-dev.railway.app
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Supabase Configuration (Optional)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=https://qogwofgwrlqxtyseqzmc.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key

# ============================================
# Cloud Services
# ============================================
# Cloudinary (shared, dev folder)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Stripe Payment (Test Keys)
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_APP_URL=https://gydi-dev.vercel.app
NEXT_PUBLIC_ENV=development

# ============================================
# Feature Flags (Development - Test new features)
# ============================================
NEXT_PUBLIC_FEATURE_ML_RECOMMENDATIONS=true
NEXT_PUBLIC_FEATURE_NEW_UI=true
NEXT_PUBLIC_FEATURE_AB_TESTING=false
NEXT_PUBLIC_FEATURE_REFERRALS=true
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=true

# ============================================
# Analytics & Monitoring (Optional)
# ============================================
# Leave empty or use test IDs
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ============================================
# Build & Runtime
# ============================================
NODE_ENV=production
