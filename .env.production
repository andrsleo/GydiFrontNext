# ============================================
# PRODUCCIÓN (VERCEL)
# ============================================
# ⚠️ IMPORTANTE: Este archivo es SOLO REFERENCIA
# Vercel NO usa este archivo
#
# Configurar variables en:
# Vercel Dashboard → Settings → Environment Variables
#
# Generar secrets: openssl rand -base64 32
# ============================================

# === NextAuth ===
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=<generar_con_openssl_rand_base64_32>

# === Backend API (Railway Production) ===
NEXT_PUBLIC_API_URL=https://gydi-backend-prod.railway.app

# === App Config ===
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_ENV=production

# === Cloudinary ===
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<tu_cloud_name>
CLOUDINARY_API_KEY=<tu_api_key>
CLOUDINARY_API_SECRET=<tu_api_secret>

# === Stripe LIVE (⚠️ Real money!) ===
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_live_...>

# === Feature Flags ===
NEXT_PUBLIC_FEATURE_ML_RECOMMENDATIONS=false
NEXT_PUBLIC_FEATURE_NEW_UI=false
NEXT_PUBLIC_FEATURE_AB_TESTING=false
NEXT_PUBLIC_FEATURE_REFERRALS=true
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=true

# === Analytics ===
NEXT_PUBLIC_GA_TRACKING_ID=<G-XXXXXXXXXX>
NEXT_PUBLIC_HOTJAR_ID=<1234567>
NEXT_PUBLIC_SENTRY_DSN=<https://xxxxx@xxxxx.ingest.sentry.io/xxxxx>
SENTRY_AUTH_TOKEN=<tu_sentry_token>

# === Runtime ===
NODE_ENV=production
