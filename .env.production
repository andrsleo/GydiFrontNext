# ============================================
# PRODUCCIÓN (VERCEL)
# ============================================
# ⚠️ IMPORTANTE: Este archivo es SOLO REFERENCIA
# Vercel NO usa este archivo
#
# Configurar variables en:
# Vercel Dashboard → Settings → Environment Variables
# ============================================

# === Backend API (Railway Production) ===
NEXT_PUBLIC_API_URL=https://gydi-backend-prod.railway.app

# === App Config ===
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_ENV=production

# === Cloudinary ===
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<tu_cloud_name>
CLOUDINARY_API_KEY=<tu_api_key>
CLOUDINARY_API_SECRET=<tu_api_secret>

# === Stripe LIVE (⚠️ Real money!) ===
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_live_...>
