# ============================================
# GYDI Frontend - Production Environment
# ============================================
# This file contains environment variables for PRODUCTION only.
# Tokens are stored in httpOnly cookies (secure, XSS-proof).

# ============================================
# Environment
# ============================================
NODE_ENV=production

# ============================================
# Backend API Configuration
# ============================================
# Public variables (exposed to browser)
# IMPORTANT: Update this to your production backend URL
NEXT_PUBLIC_API_URL=https://api.gydi.com

# ============================================
# Application Configuration
# ============================================
# Public variables (exposed to browser)
# IMPORTANT: Update this to your production frontend URL
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_APP_URL=https://gydi.com

# ============================================
# Debug
# ============================================
NEXT_PUBLIC_LOG_LEVEL=error

# ============================================
# Authentication Mode (Production)
# ============================================
# Production: Backend sets httpOnly cookies (access_token, refresh_token)
# Frontend sends cookies automatically via withCredentials: true
# No localStorage used - cookies are XSS-proof and secure

# ============================================
# Security Notes
# ============================================
# - All tokens are httpOnly cookies (cannot be accessed by JavaScript)
# - CSRF protection via X-XSRF-TOKEN header
# - Cookies have Secure flag (HTTPS only)
# - Cookies have SameSite=Strict or Lax
# - No tokens in localStorage (XSS-proof)
