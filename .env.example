# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# JWT Secret (MUST match backend configuration)
# Backend: application.yml → jwt.secret
# ⚠️ IMPORTANT: This must be the SAME value as the backend
# For production, use a strong 256-bit secret
JWT_SECRET=your-256-bit-secret-key-here-must-match-backend

# App Configuration
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_ENV=local

# Optional - Feature Flags
NEXT_PUBLIC_FEATURE_REFERRALS=true
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=true

# File Storage Strategy (images, videos, avatars)
# -----------------------------------------------
# LOCAL DEV: Leave NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME empty (or unset).
#   - Uploads go to backend → saved in GydiMicroservices/uploads/
#   - Files served at: http://localhost:8080/uploads/<folder>/<uuid>.ext
#   - No Cloudinary account needed for local testing
#
# PRODUCTION: Set NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME to your Cloudinary cloud name.
#   - Uploads go directly from browser to Cloudinary CDN (signed by backend)
#   - Files served at: https://res.cloudinary.com/<cloud_name>/...
#
# See: GydiFront/src/features/properties/hooks/use-cloudinary-direct-upload.ts
#      GydiFront/src/lib/api/storage.api.ts (profile images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional - Stripe (for payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Groq AI - Property enhancement (free tier)
# Get key at: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# Optional - Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
NEXT_PUBLIC_HOTJAR_ID=123456
NEXT_PUBLIC_SENTRY_DSN=https://...
