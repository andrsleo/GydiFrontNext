# ============================================
# GYDI Frontend - Environment Variables Template
# ============================================
# Copy this file to .env.local for local development
# NEVER commit .env.local to git (it's in .gitignore)
#
# Generate secrets using commands provided in comments
# See ../ENVIRONMENT_STRATEGY.md for detailed documentation
# ============================================

# ============================================
# NextAuth Configuration
# ============================================
# SECURITY: Generate a strong secret (minimum 32 characters)
#
# Generate using one of these methods:
#   Method 1: openssl rand -base64 32
#   Method 2: npx auth secret
#
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=INSECURE_DEV_SECRET_CHANGE_IN_PRODUCTION_USE_OPENSSL_RAND_BASE64_32

# ============================================
# Backend API Configuration
# ============================================
# Public variable (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Supabase Configuration (Optional - if used directly from frontend)
# ============================================
# Only set these if you're using Supabase client-side
# Otherwise, all DB access should go through backend API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Cloud Services
# ============================================
# Cloudinary (for client-side image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Stripe Payment (Test Keys)
# ============================================
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# Public key is safe to expose in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51SdIGWQuBbKiBgeuyICFekmubnq6NtogWfozScafwnub3BT3Nf3j9s8qccOEomqk4MrA9bTdA86pif2BH550dLwT00CLzMTdqG

# ============================================
# Application Configuration
# ============================================
# Public variables (exposed to browser)
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=local

# ============================================
# Feature Flags (Local - All enabled for testing)
# ============================================
NEXT_PUBLIC_FEATURE_ML_RECOMMENDATIONS=true
NEXT_PUBLIC_FEATURE_NEW_UI=true
NEXT_PUBLIC_FEATURE_AB_TESTING=false
NEXT_PUBLIC_FEATURE_REFERRALS=true
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=true

# ============================================
# Analytics & Monitoring (Optional - leave empty for local)
# ============================================
# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=

# Hotjar (heatmaps and session recording)
NEXT_PUBLIC_HOTJAR_ID=

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ============================================
# Build & Runtime
# ============================================
NODE_ENV=development

# ============================================
# Optional - Third-party Services
# ============================================
# Mapbox (for property maps)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ciIsImEiOiJjbXh4eHh4eHgifQ.xxxxxxxxxx
