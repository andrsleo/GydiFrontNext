# ============================================
# GYDI Frontend - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git (already in .gitignore)

# ============================================
# NextAuth Configuration
# ============================================
# SECURITY: Generate a strong secret (minimum 32 characters)
#
# Generate using one of these methods:
#   Method 1: openssl rand -base64 32
#   Method 2: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   Method 3: npx auth secret (NextAuth CLI)
#
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING_MINIMUM

# ============================================
# Backend API Configuration
# ============================================
# Public variables (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ============================================
# Application Configuration
# ============================================
# Public variables (exposed to browser)
NEXT_PUBLIC_APP_NAME=GYDI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Optional - Analytics (Production)
# ============================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Optional - Feature Flags
# ============================================
# NEXT_PUBLIC_ENABLE_REFERRALS=true
# NEXT_PUBLIC_ENABLE_SUBSCRIPTIONS=true
# NEXT_PUBLIC_MAINTENANCE_MODE=false

# ============================================
# Stripe Configuration (Payment Processing)
# ============================================
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# For development, use TEST mode keys (pk_test_... and sk_test_...)
# For production, use LIVE mode keys (pk_live_... and sk_live_...)
#
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# ============================================
# Optional - Third-party Services (Production)
# ============================================
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ciIsImEiOiJjbXh4eHh4eHgifQ.xxxxxxxxxx
